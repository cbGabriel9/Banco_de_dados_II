@using Aula02.ViewModels.StudentCourses;
@model UpdateStudentCoursesViewModel

<h1>Update</h1>

<h4>Edição da Matrícula</h4>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Update" asp-controller="StudentCourses">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <input asp-for="SelectedStudent.ID" readonly/>
            </div>

            <div class="form-group">
                @for (int i = 0; i < Model.Courses.Count; i++)
                {
                        <div class="form-check">

                            <input class="checkbox"
                               asp-for="Courses[i].IsSelected"
                                   class="form-check-input" />

                            <input type="hidden" asp-for="Courses[i].Id" />

                            <label asp-for="Courses[i].IsSelected" class="form-check-label">
                                @Model.Courses[i].Name
                            </label>

                        </div>
                }
            </div>

            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>