@using Aula02.ViewModels.SubjectsCourse;
@model CreateSubjectsCourseViewModel

<h1>Create</h1>

<h4>Matrícula por curso</h4>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" asp-controller="SubjectsCourse">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <select asp-for="CourseId" class="form-control">

                    <option value="">Selecione um aluno</option>

                    @foreach (var course in Model.Courses)
                    {
                        <option value="@course.ID">@course.Name</option>
                    }

                </select>
            </div>

            <div class="form-group">
                @for (int i = 0; i < Model.Subjects.Count; i++)
                {
                    <div class="form-check">

                        <input class="checkbox"
                               asp-for="Subjects[i].IsSelected"
                               class="form-check-input" />

                        <input type="hidden" asp-for="Subjects[i].Id" />

                        <label asp-for="Subjects[i].IsSelected" class="form-check-label">
                            @Model.Subjects[i].Name
                        </label>

                    </div>
                }
            </div>

            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>