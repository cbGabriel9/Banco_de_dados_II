@model ICollection<Aula02.Models.Course>

@{
    ViewData["Title"] = "Cursos/Matéria";
}

<div class="text-center">
    <h1 class="display-4">@Model.Count matérias por cursos.</h1>

    <a asp-action="Create" asp-controller="SubjectsCourse">Adicionar</a>

    <table class="table table-responsive table-hover table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.ID</td>
                    <td>@c.Name</td>
                    <td>
                        <a asp-controller="SubjectsCourse" asp-action="Update" asp-route-courseId="@c.ID" method="get">
                            Editar
                        </a>
                    </td>
                </tr>

                @if (c.SubjectsCourse!.Count > 0)
                {

                    <tr>
                        <td colspan="5">
                            <ul>
                                @foreach (var sc in c.SubjectsCourse!)
                                {
                                    <li>
                                        - @sc.Subject?.Name -
                                        <form asp-controller="SubjectsCourse" asp-action="Delete" method="post">
                                            <input type="hidden" name="courseId" value="@sc.CourseID" />
                                            <input type="hidden" name="subjectId" value="@sc.SubjectID" />
                                            <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </td>
                    </tr>
                }
            }
        </tbody>
</table>
</div>
